PORT=5000

# MySQL connection (local)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=healio
# Optional: Unix socket (use if TCP to localhost fails)
# DB_SOCKET=/path/to/mysql.sock

# Cloud MySQL (TiDB Cloud on Vercel Marketplace sets these automatically)
# TIDB_HOST=
# TIDB_PORT=4000
# TIDB_USER=
# TIDB_PASSWORD=
# TIDB_DATABASE=
# Or a single URL:
# DATABASE_URL=mysql://user:pass@host:4000/healio
# DB_SSL=true

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Optional seed overrides (npm run seed)
# SEED_ADMIN_EMAIL=admin@healio.local
# SEED_ADMIN_PASSWORD=Admin123!
# SEED_DOCTOR_EMAIL=doctor@healio.local
# SEED_DOCTOR_PASSWORD=Doctor123!
