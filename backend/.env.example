PORT=5000

# MySQL connection (copy to .env and fill in your local values)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=healio
# Optional: Unix socket (use if TCP to localhost fails)
# DB_SOCKET=/path/to/mysql.sock

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Optional seed overrides (npm run seed)
# SEED_ADMIN_EMAIL=admin@healio.local
# SEED_ADMIN_PASSWORD=Admin123!
# SEED_DOCTOR_EMAIL=doctor@healio.local
# SEED_DOCTOR_PASSWORD=Doctor123!
